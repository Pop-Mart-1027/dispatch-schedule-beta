rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function employeePath() { return /databases/$(database)/documents/employees/$(request.auth.token.employeeId); }
    function isActiveEmployee() {
      return signedIn() && request.auth.token.employeeId is string
        && request.auth.token.mustChangePassword == false
        && exists(employeePath()) && get(employeePath()).data.active == true
        && get(employeePath()).data.mustChangePassword == false;
    }
    function isAdmin() {
      return isActiveEmployee() && request.auth.token.role == 'admin'
        && get(employeePath()).data.role == 'admin';
    }
    function isDuty() {
      return isActiveEmployee() && request.auth.token.role in ['duty', 'admin']
        && get(employeePath()).data.role in ['duty', 'admin'];
    }

    match /employees/{employeeId} {
      // Own record remains readable after disable so the client can immediately sign out.
      allow get: if signedIn() && (request.auth.token.employeeId == employeeId || isActiveEmployee());
      allow list: if isActiveEmployee();
      // All employee-master mutations go through trusted Admin SDK functions.
      allow create, update, delete: if false;
    }

    match /attendanceLocations/{locationId} {
      allow read: if isActiveEmployee();
      allow create, update, delete: if isAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow read: if isActiveEmployee()
        && (isAdmin() || resource.data.employeeId == request.auth.token.employeeId);
      allow create: if isActiveEmployee()
        && request.resource.data.employeeId == request.auth.token.employeeId
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'date', 'punchType', 'timestamp',
          'scheduleCode', 'dispatchAreaCode', 'locationId', 'locationName',
          'latitude', 'longitude', 'accuracy', 'distanceMeters',
          'withinGeofence', 'status', 'abnormalReason', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /scheduleRecords/{recordId} {
      allow get, list: if isActiveEmployee();
      allow create, update, delete: if isAdmin();
    }
    match /scheduleMonthLayouts/{monthId} {
      allow read: if isActiveEmployee();
      // Row operations and their audit are committed together by the admin callable.
      allow write: if false;
    }
    match /scheduleAuditLogs/{auditId} {
      allow read: if isDuty();
      allow create: if isAdmin()
        && request.resource.data.employeeId is string
        && request.resource.data.date is string
        && request.resource.data.modifiedBy == request.auth.token.employeeId
        && request.resource.data.modifiedAt == request.time;
      allow update, delete: if false;
    }

    match /systemSettings/features {
      allow get: if isActiveEmployee();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['attendanceEnabled','broadcastsEnabled','dispatchEnabled','updatedBy','updatedAt'])
        && request.resource.data.attendanceEnabled is bool
        && request.resource.data.broadcastsEnabled is bool
        && request.resource.data.dispatchEnabled is bool
        && request.resource.data.updatedBy == request.auth.token.employeeId
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /scheduleSettings/{monthId} {
      allow read: if isDuty();
      allow create, update, delete: if isAdmin();
    }

    match /preScheduleMonths/{monthId} {
      function preScheduleReader() { return isActiveEmployee() && request.auth.uid == request.auth.token.employeeId; }
      allow read: if preScheduleReader();
      // Trusted callable checks current profile + claim, deadline, revisions and audit.
      allow write: if false;
      match /entries/{employeeId} {
        allow get: if preScheduleReader() && (isDuty() || request.auth.token.employeeId == employeeId);
        allow list: if preScheduleReader() && isDuty();
        allow write: if false;
      }
      match /auditLogs/{auditId} {
        allow read: if preScheduleReader() && isDuty();
        allow write: if false;
      }
      match /internal/{document=**} { allow read, write: if false; }
    }

    match /dispatchRecords/{recordId} {
      allow get, list: if isActiveEmployee();
      allow create: if isActiveEmployee() && isDuty()
        && request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && request.resource.data.date is string
        && request.resource.data.source is string
        && request.resource.data.modifiedBy == request.auth.token.employeeId
        && request.resource.data.modifiedAt == request.time;
      allow update: if isAdmin()
        || (isActiveEmployee() && isDuty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'areaCode', 'areaName', 'vehicleType', 'vehicleNo', 'driver', 'assistant',
            'station', 'workFocus', 'balanceArea', 'note', 'modifiedBy', 'modifiedAt', 'updatedAt'
          ])
          && request.resource.data.modifiedBy == request.auth.token.employeeId
          && request.resource.data.modifiedAt == request.time
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }
    match /dispatchBlocks/{blockId} {
      allow get, list: if isActiveEmployee();
      allow create: if isAdmin()
        || (isActiveEmployee() && isDuty()
          && request.resource.data.keys().hasOnly([
            'date', 'shiftType', 'blockId', 'areaCode', 'areaName', 'variantCode',
            'vehicleNo', 'vehicleType', 'drivers', 'stations', 'assistants',
            'workFocus', 'balanceArea', 'note', 'sourceSheet', 'sourceRow',
            'sourceUpdatedAt', 'status', 'createdAt', 'updatedAt', 'modifiedBy', 'modifiedAt'
          ])
          && request.resource.data.blockId == blockId
          && request.resource.data.date is string
          && request.resource.data.shiftType in ['day', 'night']
          && request.resource.data.drivers is list
          && request.resource.data.stations is list
          && request.resource.data.assistants is list
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.modifiedBy == '' && request.resource.data.modifiedAt == null)
            || (request.resource.data.modifiedBy == request.auth.token.employeeId
              && request.resource.data.modifiedAt == request.time)));
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isActiveEmployee() && isDuty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'areaName', 'vehicleNo', 'drivers', 'stations', 'assistants', 'workFocus',
            'balanceArea', 'note', 'modifiedBy', 'modifiedAt', 'updatedAt'
          ])
          && request.resource.data.modifiedBy == request.auth.token.employeeId
          && request.resource.data.modifiedAt == request.time
          && request.resource.data.updatedAt == request.time);
    }
    match /dispatchAuditLogs/{auditId} {
      allow read, create: if isDuty();
      allow update, delete: if false;
    }

    match /dispatchConfiguration/{id} {
      allow read: if isActiveEmployee();
      allow create: if isDuty() && id == 'base'
        && request.resource.data.keys().hasOnly(['activeFrom','blocks','createdAt','modifiedBy'])
        && request.resource.data.activeFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.blocks is list && request.resource.data.blocks.size() <= 400
        && request.resource.data.createdAt == request.time
        && request.resource.data.modifiedBy == request.auth.token.employeeId;
      allow update, delete: if false;
    }
    match /dispatchConfigurationVersions/{versionId} {
      allow read: if isActiveEmployee();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['effectiveFrom','slot','values','manualPeople','modifiedBy','createdAt','auditId'])
        && request.resource.data.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slot is string
        && request.resource.data.manualPeople is bool
        && request.resource.data.values.keys().hasOnly(['areaName','vehicleNo','drivers','stations','assistants','workFocus','balanceArea','note'])
        && request.resource.data.values.areaName is string
        && request.resource.data.values.vehicleNo is string
        && request.resource.data.values.drivers is list
        && request.resource.data.values.stations is list
        && request.resource.data.values.assistants is list
        && request.resource.data.values.workFocus is string
        && request.resource.data.modifiedBy == request.auth.token.employeeId
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/dispatchAuditLogs/$(request.resource.data.auditId)).data.versionId == versionId
        && getAfter(/databases/$(database)/documents/dispatchAuditLogs/$(request.resource.data.auditId)).data.modifiedBy == request.auth.token.employeeId;
      allow update, delete: if false;
    }

    match /areaMaster/{areaCode} {
      allow read: if isActiveEmployee();
      allow write: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isActiveEmployee();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isActiveEmployee();
      allow create, update: if isAdmin()
        && announcementId == 'current'
        && request.resource.data.keys().hasOnly([
          'imageUrl', 'originalName', 'mediaType', 'originalSize', 'storedBytes',
          'width', 'height', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 750000
        && request.resource.data.updatedBy == request.auth.token.employeeId
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /broadcastReads/{readId} {
      function isOwnAuth() {
        return isActiveEmployee()
          && request.auth.uid == request.auth.token.employeeId;
      }
      function isOwnReadId() {
        return isOwnAuth()
          && readId.matches('^.+_' + request.auth.token.employeeId + '$');
      }
      function isOwnNewRead() {
        return isOwnAuth()
          && request.resource.data.employeeId == request.auth.token.employeeId
          && request.resource.data.broadcastId is string
          && request.resource.id == request.resource.data.broadcastId + '_' + request.auth.token.employeeId;
      }
      // Single-document get must not depend on resource.data: the document may not exist yet.
      allow get: if isOwnReadId();
      allow list: if isOwnAuth() && resource.data.employeeId == request.auth.token.employeeId
        && readId == resource.data.broadcastId + '_' + request.auth.token.employeeId;
      allow create: if isOwnNewRead()
        && request.resource.data.keys().hasOnly(['broadcastId', 'employeeId', 'firstShownAt', 'lastShownAt', 'readAt', 'shownCount']);
      allow update: if isOwnReadId() && isOwnNewRead()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstShownAt', 'lastShownAt', 'readAt', 'shownCount']);
      allow delete: if false;
    }

    match /auditLogs/{entryId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
