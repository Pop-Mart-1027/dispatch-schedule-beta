rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function employeePath() { return /databases/$(database)/documents/employees/$(request.auth.token.employeeId); }
    function isActiveEmployee() {
      return signedIn() && request.auth.token.employeeId is string
        && request.auth.token.mustChangePassword == false
        && exists(employeePath()) && get(employeePath()).data.active == true
        && get(employeePath()).data.mustChangePassword == false;
    }
    function isAdmin() {
      return isActiveEmployee() && request.auth.token.role == 'admin'
        && get(employeePath()).data.role == 'admin';
    }

    // Existing breakfast-order rules are preserved.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == "new"
        && request.resource.data.paid == false
        && request.resource.data.total > 0
        && request.resource.data.paymentMethod in ["cash", "linepay"]
        && request.resource.data.paymentStatus in ["unpaid", "initiating"];
      allow update: if
        (resource.data.status == "new" && request.resource.data.status == "done"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
        || (resource.data.paymentMethod == "cash" && resource.data.paymentStatus == "unpaid"
          && request.resource.data.paymentStatus == "paid" && request.resource.data.cashReceived >= resource.data.total
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus","paidAt","cashReceived","cashChange"]))
        || (resource.data.paymentMethod == "linepay" && request.resource.data.paymentStatus == "payment_error"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus"]))
        || (resource.data.paymentMethod == "cash" && resource.data.paymentStatus == "unpaid"
          && request.resource.data.total > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["items","total","counterEditedAt"]))
        || (resource.data.paymentMethod == "cash" && resource.data.paymentStatus == "unpaid"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["orderNote","counterEditedAt"]))
        || (resource.data.paymentMethod == "cash" && resource.data.paymentStatus == "unpaid"
          && request.resource.data.paymentStatus == "cancelled" && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus","status","cancelledAt","cancelReason"]))
        || (resource.data.paymentStatus == "paid" && request.resource.data.refundRecorded == true
          && request.resource.data.refundMethod == "cash" && request.resource.data.refundAmount > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["refundRecorded","refundMethod","refundAmount","refundNote","refundRecordedAt"]));
      allow delete: if false;
    }

    match /counters/{dateKey} {
      allow read: if true;
      allow create: if request.resource.data.lastNo == 1;
      allow update: if request.resource.data.lastNo == resource.data.lastNo + 1;
      allow delete: if false;
    }

    match /employees/{employeeId} {
      // Own record remains readable after disable so the client can immediately sign out.
      allow get: if signedIn() && (request.auth.token.employeeId == employeeId || isAdmin());
      allow list: if isAdmin();
      // All employee-master mutations go through trusted Admin SDK functions.
      allow create, update, delete: if false;
    }

    match /attendanceLocations/{locationId} {
      allow read: if isActiveEmployee();
      allow create, update, delete: if isAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow read: if isActiveEmployee()
        && (isAdmin() || resource.data.employeeId == request.auth.token.employeeId);
      allow create: if isActiveEmployee()
        && request.resource.data.employeeId == request.auth.token.employeeId
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'date', 'punchType', 'timestamp',
          'scheduleCode', 'dispatchAreaCode', 'locationId', 'locationName',
          'latitude', 'longitude', 'accuracy', 'distanceMeters',
          'withinGeofence', 'status', 'abnormalReason', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{entryId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
